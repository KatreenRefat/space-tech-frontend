# Copy to .env.local and edit only what you need — .env.local is git-ignored.
#
# Everything already works with no .env file at all: the backend domain lives in
# src/config/api.js (DEFAULT_API_ORIGIN) and both the dev proxy and the runtime
# HTTP client read it from there.

# Point the app at a different backend, e.g. one running on your machine.
# Dev: the Vite proxy forwards /api to this origin.
# Build: requests go here directly, so this origin must allow the site's origin
#        via CORS.
# VITE_API_ORIGIN=http://localhost:8080
